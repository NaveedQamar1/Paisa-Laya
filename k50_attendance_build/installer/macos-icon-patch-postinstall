#!/bin/bash
set -euo pipefail

APP="/Applications/SCAFA_Workforce.app"
ICON_SOURCE="$APP/Contents/Resources/scafa_workforce_icon.icns"
PLIST="$APP/Contents/Info.plist"

if [ ! -d "$APP" ] || [ ! -f "$PLIST" ]; then
  echo "SCAFA Workforce was not found in /Applications. Install the full application first." >&2
  exit 1
fi

if [ ! -f "$ICON_SOURCE" ]; then
  echo "The SCAFA icon resource is missing. Install the full SCAFA Workforce 1.3.0 package instead." >&2
  exit 1
fi

# Changing Info.plist invalidates a signed app bundle. Do not damage a signed installation.
if /usr/bin/codesign -dv "$APP" >/dev/null 2>&1; then
  echo "This installation is code-signed. Use the full signed SCAFA Workforce installer instead." >&2
  exit 1
fi

/usr/libexec/PlistBuddy -c "Set :CFBundleIconFile scafa_workforce_icon.icns" "$PLIST" 2>/dev/null || \
  /usr/libexec/PlistBuddy -c "Add :CFBundleIconFile string scafa_workforce_icon.icns" "$PLIST"

touch "$APP"
/usr/bin/killall Dock >/dev/null 2>&1 || true
exit 0

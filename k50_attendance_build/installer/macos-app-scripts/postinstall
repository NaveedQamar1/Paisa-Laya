#!/bin/bash
set -euo pipefail

LABEL="pk.scafa.workforce.monitor"
APP_BUNDLE="/Applications/SCAFA_Workforce.app"
MONITOR_EXECUTABLE="$APP_BUNDLE/Contents/MacOS/scafa-monitor"
STATE_DIR="/var/db/scafa-workforce-installer"
STATE_FILE="$STATE_DIR/monitor-state"

log() {
    echo "SCAFA Workforce installer: $*" >&2
}

fail() {
    log "ERROR: $*"
    exit 1
}

clear_state() {
    /bin/rm -f "$STATE_FILE" || fail "The monitor was restored, but installer recovery state could not be removed."
    /bin/rmdir "$STATE_DIR" 2>/dev/null || true
}

if [ "$(/usr/bin/id -u)" -ne 0 ]; then
    fail "The Intel macOS installer lifecycle script must run as root."
fi

# No marker means the monitor was not loaded before installation. Do not
# enable monitoring as a side effect of a clean install or an upgrade.
if [ ! -e "$STATE_FILE" ] && [ ! -L "$STATE_FILE" ]; then
    log "No previously loaded monitor was recorded; leaving monitoring unchanged."
    exit 0
fi
if [ -L "$STATE_FILE" ] || [ ! -f "$STATE_FILE" ]; then
    fail "Installer recovery state is not a regular file."
fi
state_owner=$(/usr/bin/stat -f '%u' "$STATE_FILE") || fail "Could not verify installer recovery-state ownership."
state_mode=$(/usr/bin/stat -f '%Lp' "$STATE_FILE") || fail "Could not verify installer recovery-state permissions."
[ "$state_owner" = "0" ] && [ "$state_mode" = "600" ] || fail "Installer recovery state is not protected as a root-owned mode-600 file."

uid=$(/usr/bin/sed -n '1p' "$STATE_FILE")
extra_state=$(/usr/bin/sed -n '2p' "$STATE_FILE")
case "$uid" in
    *[!0-9]*|'') fail "Installer recovery state contains an invalid user ID." ;;
esac
[ "$uid" -gt 0 ] || fail "Installer recovery state does not identify a non-root login user."
[ -z "$extra_state" ] || fail "Installer recovery state contains unexpected extra data."

users=$(/usr/bin/dscl . -list /Users UniqueID 2>&1) || fail "Could not enumerate local macOS users: $users"
username=$(printf '%s\n' "$users" | /usr/bin/awk -v uid="$uid" '$2 == uid { print $1; exit }')
[ -n "$username" ] || fail "The original monitor owner (UID $uid) no longer exists."

home_record=$(/usr/bin/dscl . -read "/Users/$username" NFSHomeDirectory 2>&1) || fail "Could not resolve the original monitor owner's home directory: $home_record"
home=${home_record#NFSHomeDirectory: }
[ "$home" != "$home_record" ] && [ -n "$home" ] || fail "The original monitor owner's home directory is invalid."
case "$home" in
    /*) ;;
    *) fail "The original monitor owner's home directory is not an absolute path." ;;
esac

plist="$home/Library/LaunchAgents/$LABEL.plist"
if [ -L "$plist" ] || [ ! -f "$plist" ]; then
    fail "The previously loaded monitor's LaunchAgent plist is missing, linked, or not a regular file: $plist"
fi
plist_owner=$(/usr/bin/stat -f '%u' "$plist") || fail "Could not verify LaunchAgent ownership."
[ "$plist_owner" = "$uid" ] || fail "The LaunchAgent plist is no longer owned by its original login user."

if [ -L "$APP_BUNDLE" ] || [ ! -d "$APP_BUNDLE" ]; then
    fail "The new application bundle is missing, linked, or not a real directory; monitor recovery state was retained."
fi
if [ -L "$MONITOR_EXECUTABLE" ] || [ ! -f "$MONITOR_EXECUTABLE" ] || [ ! -x "$MONITOR_EXECUTABLE" ]; then
    fail "The new monitor helper is missing, linked, or not a regular executable file; monitor recovery state was retained."
fi
plist_label=$(/usr/libexec/PlistBuddy -c 'Print :Label' "$plist" 2>/dev/null) || fail "Could not read the LaunchAgent label."
[ "$plist_label" = "$LABEL" ] || fail "The LaunchAgent label does not match the SCAFA monitor."
program=$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$plist" 2>/dev/null) || fail "Could not read the LaunchAgent executable path."
[ "$program" = "$MONITOR_EXECUTABLE" ] || fail "The LaunchAgent does not point to the newly installed monitor helper."

domain="gui/$uid"
service="$domain/$LABEL"
if domain_output=$(/bin/launchctl print "$domain" 2>&1); then
    if service_output=$(/bin/launchctl print "$service" 2>&1); then
        log "The previously loaded monitor is already registered."
    else
        case "$service_output" in
            *"Could not find service"*|*"No such process"*)
                if ! bootstrap_output=$(/bin/launchctl bootstrap "$domain" "$plist" 2>&1); then
                    if ! /bin/launchctl print "$service" >/dev/null 2>&1; then
                        fail "Could not restore the previously loaded monitor: $bootstrap_output"
                    fi
                fi
                ;;
            *) fail "Could not determine the monitor's current launchd state: $service_output" ;;
        esac
    fi

    /bin/launchctl print "$service" >/dev/null 2>&1 || fail "The monitor bootstrap completed, but launchd did not confirm the service is loaded."
else
    case "$domain_output" in
        *"Could not find domain"*|*"No such process"*)
            run_at_load=$(/usr/libexec/PlistBuddy -c 'Print :RunAtLoad' "$plist" 2>/dev/null) || fail "No GUI session is available and the LaunchAgent is not configured to start at login."
            [ "$run_at_load" = "true" ] || fail "No GUI session is available and the LaunchAgent does not have RunAtLoad enabled."
            log "The original user has no active GUI session; the verified RunAtLoad agent will start at the next login."
            clear_state
            exit 0
            ;;
        *) fail "Could not access the original user's GUI session to restore monitoring: $domain_output" ;;
    esac
fi

clear_state
log "Restored and verified the previously loaded monitor for user ID $uid."
exit 0
